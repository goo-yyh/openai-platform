# Copy to .env and supply your existing OpenAI Platform API key.
OPENAI_API_KEY=
# Generated by: python3 scripts/gateway.py init
GATEWAY_TOKEN=
# Optional: a model your API project can access, recognized by your Codex version.
CODEX_MODEL=gpt-6.1-sol
# Optional public HTTPS origin (without /v1). Empty uses local/SSH 127.0.0.1:8787.
GATEWAY_URL=
# Optional SSH deployment settings. Keep real values only in your ignored .env.
IP=
NAME=
PASSWORD=
SSH_PORT=22
# Relative to the remote user's home directory, or an absolute writable path.
SERVER_PATH=services/openai-platform
